# Compose interpolation only. Copy to .env.staging and replace every placeholder.
# Pass this file explicitly: docker compose --env-file .env.staging -f docker-compose.staging.yml ...

STAGING_POSTGRES_DB=telegram_panel_staging
STAGING_POSTGRES_USER=staging_panel
STAGING_POSTGRES_PASSWORD=replace-with-a-unique-staging-postgres-password
STAGING_REDIS_PASSWORD=replace-with-a-unique-staging-redis-password

# May point elsewhere, but the filename/path must contain "staging" or "test".
STAGING_BACKEND_ENV_FILE=./backend/.env.staging

# Loopback is the safe default. Use an SSH tunnel for remote acceptance testing.
STAGING_GATEWAY_BIND=127.0.0.1
STAGING_GATEWAY_PORT=8080
STAGING_FRONTEND_URL=http://127.0.0.1:8080

# Build/deploy markers for /health/version.
STAGING_GIT_SHA=dev
STAGING_GIT_REF=feature-branch
STAGING_BUILD_TIME=unknown
STAGING_IMAGE_TAG=staging
