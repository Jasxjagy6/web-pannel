# Start with backend/.env.example to retain every current feature knob:
#   cp backend/.env.example backend/.env.staging
# Then replace its critical values with the staging-only values below. Compose
# fixes DB/Redis hosts and credentials to its physical staging services.

DEPLOY_ENV=staging
DEPLOY_COLOR=staging
# Compose also injects GIT_SHA, GIT_REF, BUILD_TIME, and IMAGE_TAG from
# .env.staging so /health/version identifies the accepted feature revision.
NODE_ENV=production
ALLOW_TEST_EXTERNAL_ACCOUNTS=true
PORT=3005
API_PREFIX=/api
FRONTEND_URL=http://127.0.0.1:8080

DB_HOST=staging-postgres
DB_PORT=5432
DB_NAME=telegram_panel_staging
DB_USER=staging_panel
DB_PASSWORD=replace-with-the-same-staging-postgres-password-as-root-env
REDIS_HOST=staging-redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-the-same-staging-redis-password-as-root-env
SKIP_BOOT_MIGRATIONS=false

JWT_SECRET=replace-with-a-unique-random-staging-jwt-secret
SESSION_ENCRYPTION_KEY=replace-with-a-different-unique-random-staging-session-key
ADMIN_EMAIL=staging-admin@example.test
ADMIN_PASSWORD=replace-with-a-unique-staging-admin-password

UPLOAD_DIR=/app/uploads
UPLOAD_DIR_ABS=/app/uploads
LOG_FILE=/app/logs/app.log

# Use only API credentials and external accounts created specifically for tests.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Keep feature-specific settings from backend/.env.example below this point.
# Never copy credentials, Telegram session strings, uploads, or auth keys from production.
